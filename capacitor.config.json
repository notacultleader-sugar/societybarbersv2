{
  "appId": "com.thesocietybarbers.app",
  "appName": "Society Barbers",
  "webDir": "dist/mobile",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
