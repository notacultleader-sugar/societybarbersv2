<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<!--
		NSPrivacyTrackingDomains is intentionally empty. Declaring fresha.com here
		would make iOS block connections to our booking provider whenever the user
		chooses "Ask App Not to Track", which would break booking, sign-in, gift
		cards and memberships. Fresha is a first-party booking provider we use for
		our own bookings, not an advertising network we send data to.
	-->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
</dict>
</plist>
