<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		The app collects no data and does no tracking.

		There are no analytics or advertising SDKs, the IDFA is never read, and no
		device data is sent anywhere. Booking, sign-in, memberships and gift cards
		open Fresha's own website in SFSafariViewController (Capacitor Browser),
		which runs out of process: the app cannot read that page, its cookies, or
		anything the user types into it. Data a user provides directly to a website
		they browse is not data collected by this app, so NSPrivacyTracking is false
		and no collected data types are declared.

		NSPrivacyTrackingDomains is empty because the app declares no tracking and
		fresha.com is our booking provider, not an advertising endpoint.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
</dict>
</plist>
